# Ascend Nexus Media Web environment template.
# Copy to an untracked .env file for local development. Do not commit real secrets.

APP_ENV=development
APP_SERVICE_NAME=ascend-nexus-media-api
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=5313
PUBLIC_API_BASE_URL=http://127.0.0.1:5313/api/public
PUBLIC_APP_BASE_URL=http://127.0.0.1:5303
ADMIN_APP_BASE_URL=http://127.0.0.1:5303/admin
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5303,http://localhost:5303

# Backend-only auth settings. These placeholders fail production validation.
AUTH_ENABLED=false
AUTH_PROVIDER=dev
AUTH_SESSION_SECRET=<GENERATE_A_STRONG_SECRET>
AUTH_ACCESS_TOKEN_SECRET=<GENERATE_A_STRONG_SECRET>
AUTH_REFRESH_TOKEN_SECRET=<GENERATE_A_STRONG_SECRET>
AUTH_COOKIE_SECURE=false
MEDIA_AUTH_DISABLED=false
MEDIA_ADMIN_DEV_TOKEN=dev-admin-token

# Persistence.
MONGODB_URI=
MONGODB_DATABASE=ascend_nexus_media
DATABASE_AUTO_MIGRATE=false
REDIS_URL=
REDIS_PREFIX=anm-media

# Storage.
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_MOCK_ENABLED=false
MEDIA_STORAGE_LOCAL_ENABLED=true
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_BUCKET=ascend-nexus-media-local
MEDIA_STORAGE_REGION=auto
MEDIA_STORAGE_ACCESS_KEY_ID=
MEDIA_STORAGE_SECRET_ACCESS_KEY=
MEDIA_STORAGE_PUBLIC_BASE_URL=/uploads/media/public
MEDIA_STORAGE_PUBLIC_PREFIX=public
MEDIA_STORAGE_PRIVATE_PREFIX=private
MEDIA_STORAGE_ALLOW_PRODUCTION_MOCK_FALLBACK=false

# CDN.
MEDIA_CDN_ENABLED=false
MEDIA_CDN_PROVIDER=none
MEDIA_CDN_BASE_URL=

# Uploads and processing.
MEDIA_UPLOADS_ENABLED=true
MEDIA_DIRECT_UPLOAD_ENABLED=false
MEDIA_WORKERS_ENABLED=false
MEDIA_IMAGE_PROCESSING_ENABLED=false
MEDIA_AUDIO_METADATA_ENABLED=false
MEDIA_AUDIO_WAVEFORM_ENABLED=false
MEDIA_AUDIO_TRANSCODE_ENABLED=false
MEDIA_VIRUS_SCAN_ENABLED=false
MEDIA_FILE_SIGNATURE_VALIDATION_REQUIRED=true
FFMPEG_PATH=
FFPROBE_PATH=

# Publication and public delivery.
MEDIA_PUBLICATION_ENABLED=true
PUBLIC_API_ENABLED=true
PUBLIC_API_SEED_FALLBACK_ENABLED=true
PUBLIC_CACHE_ENABLED=false

# Email, analytics, monitoring.
EMAIL_ENABLED=false
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
CONTACT_NOTIFICATION_RECIPIENTS=
NEWSLETTER_ENABLED=false
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=none
ANALYTICS_PUBLIC_MEASUREMENT_ID=
ANALYTICS_API_SECRET=
MONITORING_ENABLED=false
MONITORING_PROVIDER=none
MONITORING_DSN=

# Security and logging.
SECURITY_HELMET_ENABLED=false
SECURITY_CSP_ENABLED=false
SECURITY_RATE_LIMIT_ENABLED=false
SECURITY_CSRF_ENABLED=false
SECURITY_ERROR_DETAILS_ENABLED=true
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_PRETTY=true

# Frontend-safe Vite values only. Never put backend secrets in VITE_ variables.
VITE_APP_NAME=Ascend Nexus Media
VITE_PUBLIC_CONFIG_URL=
VITE_PUBLIC_API_BASE_URL=http://127.0.0.1:5313/api/public
VITE_PUBLIC_SITE_URL=http://127.0.0.1:5303
VITE_MEDIA_UPLOAD_API_BASE_URL=http://127.0.0.1:5313
VITE_MEDIA_STORAGE_PROVIDER=custom
VITE_MEDIA_MOCK_UPLOADS=false
